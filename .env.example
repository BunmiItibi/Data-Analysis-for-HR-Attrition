# Copy this file to .env.local and fill in real values for a live deployment.
# Experix runs in demo mode automatically whenever Supabase and/or Anthropic
# variables are absent — see README.md "Demo mode" for details. Never commit
# .env.local or any file containing real secrets.

# --- Supabase --------------------------------------------------------------
# Both required to leave demo mode for auth/database/storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the admin review queue and scripts/seed-supabase.ts.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix — keep it that way).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
# Required to leave demo mode for AI colleague replies and assessment.
# Used only in server-side API routes — never sent to the browser.
ANTHROPIC_API_KEY=
# Optional override; defaults to a current Claude model if unset.
ANTHROPIC_MODEL=claude-sonnet-5
